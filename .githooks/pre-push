#!/bin/sh
# Check the actual refs Git is about to send, including non-current branches.
set -eu
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_ref:$remote_ref" in
        refs/heads/archive/*:*|*:refs/heads/archive/*)
            echo "拒绝推送本地归档分支：$local_ref -> $remote_ref" >&2
            exit 1
            ;;
    esac
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    python3 scripts/check_public.py --ref "$local_oid"
done
